# Local development only. Copy to .env and set your own database password.
# Docker Compose reads .env; export these variables before launching Java/Maven.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbooker
DB_USERNAME=tbooker
DB_PASSWORD=replace-with-a-local-development-password
SERVER_PORT=8080
# Required: generate a random Base64 key with `openssl rand -base64 32`.
# Paste the generated value locally. Never commit a real signing key.
JWT_SECRET=
JWT_ISSUER=tbooker
JWT_AUDIENCE=tbooker-api
JWT_TTL=PT15M
# Opt in only on a dedicated development database to load sample catalogue data:
# SPRING_PROFILES_ACTIVE=dev
