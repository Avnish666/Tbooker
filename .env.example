# Local development only. Copy to .env and set your own database password.
# Docker Compose reads .env; export these variables before launching Java/Maven.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbooker
DB_USERNAME=tbooker
# Required: choose a private local password; blank fails Compose validation.
DB_PASSWORD=
SERVER_PORT=8080
# Required: generate a random Base64 key with `openssl rand -base64 32`.
# Paste the generated value locally. Never commit a real signing key.
JWT_SECRET=
JWT_ISSUER=tbooker
JWT_AUDIENCE=tbooker-api
JWT_TTL=PT15M
# Opt in only on a dedicated development database to load sample catalogue data:
# SPRING_PROFILES_ACTIVE=dev

# Mock payments only: no real money or payment credentials.
PAYMENTS_MOCK_AMOUNT_MINOR=10000
PAYMENTS_MOCK_UPI_OUTCOME=SUCCESS
PAYMENTS_MOCK_CARD_OUTCOME=SUCCESS
# Each outcome accepts SUCCESS, FAILED, or PENDING; applies only to new mock receipts.

# Optional local metadata cache; Compose binds an unauthenticated cache to loopback only.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=200ms
REDIS_COMMAND_TIMEOUT=200ms
CATALOGUE_CACHE_ENABLED=true
CACHE_METADATA_TTL=PT10M
CACHE_METADATA_LIST_TTL=PT5M
CACHE_SHOW_TTL=PT1M
CACHE_SHOW_LIST_TTL=PT30S

# Local single-node KRaft Kafka; PLAINTEXT loopback is not a production security setup.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MESSAGING_ENABLED=true
MESSAGING_SCHEDULING_ENABLED=true
BOOKING_EVENTS_TOPIC=tbooker.booking-confirmed.v1
BOOKING_EVENTS_DLT=tbooker.booking-confirmed.v1.DLT
BOOKING_NOTIFICATION_GROUP=tbooker-notifications-v1
BOOKING_ANALYTICS_GROUP=tbooker-analytics-v1
BOOKING_TOPIC_PARTITIONS=3
BOOKING_TOPIC_REPLICAS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE=PT30S
OUTBOX_RETRY_INITIAL=PT1S
OUTBOX_RETRY_MAX=PT1M
BOOKING_CONSUMER_RETRIES=3
KAFKA_DELIVERY_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=2000
KAFKA_MAX_BLOCK_MS=1000

# Standalone compose.scaled.yaml settings (not needed by host workflow).
# Scaled containers use postgres:5432, redis:6379, kafka:19092 and app port 8080;
# DB_HOST/DB_PORT, REDIS_HOST/REDIS_PORT, KAFKA_BOOTSTRAP_SERVERS and SERVER_PORT
# above are host-workflow settings, deliberately overridden inside this stack.
# Redis credentials above are for an external host-workflow Redis only.
# All cache/payment/messaging/JWT policy settings above also reach both replicas.
LB_BIND_ADDRESS=127.0.0.1
LB_PORT=8080
DB_POOL_SIZE=20
RESERVATION_CLEANUP_MS=30000
OUTBOX_POLL_MS=1000
# INSTANCE_ID defaults to local; scaled Compose assigns app-a/app-b.
