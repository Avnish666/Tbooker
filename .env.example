# Local development only. Copy to .env and set your own database password.
# Docker Compose reads .env; export these variables before launching Java/Maven.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbooker
DB_USERNAME=tbooker
DB_PASSWORD=replace-with-a-local-development-password
SERVER_PORT=8080
# Required: generate a random Base64 key with `openssl rand -base64 32`.
# Paste the generated value locally. Never commit a real signing key.
JWT_SECRET=
JWT_ISSUER=tbooker
JWT_AUDIENCE=tbooker-api
JWT_TTL=PT15M
# Opt in only on a dedicated development database to load sample catalogue data:
# SPRING_PROFILES_ACTIVE=dev

# Mock payments only: no real money or payment credentials.
PAYMENTS_MOCK_AMOUNT_MINOR=10000
PAYMENTS_MOCK_UPI_OUTCOME=SUCCESS
PAYMENTS_MOCK_CARD_OUTCOME=SUCCESS
# Each outcome accepts SUCCESS, FAILED, or PENDING; applies only to new mock receipts.

# Optional local metadata cache; Compose binds an unauthenticated cache to loopback only.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=200ms
REDIS_COMMAND_TIMEOUT=200ms
CATALOGUE_CACHE_ENABLED=true
CACHE_METADATA_TTL=PT10M
CACHE_METADATA_LIST_TTL=PT5M
CACHE_SHOW_TTL=PT1M
CACHE_SHOW_LIST_TTL=PT30S
