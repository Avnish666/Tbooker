{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbooker:booking-confirmed:v1",
  "title": "BookingConfirmed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "version",
    "bookingId",
    "userId",
    "showId",
    "showSeatId",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "BookingConfirmed"
    },
    "version": {
      "const": 1
    },
    "bookingId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "userId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "showId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "showSeatId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
